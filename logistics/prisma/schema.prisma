generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Пользователи (клиенты + админы)
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  phone     String?
  company   String?
  role      String     @default("client") // client, admin
  orders    Order[]
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Услуги
model Service {
  id            String   @id @default(cuid())
  slug          String   @unique // air, sea, rail, road, project
  nameRu        String
  nameEn        String
  descriptionRu String   @db.Text
  descriptionEn String   @db.Text
  icon          String
  features      String[]
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  tariffs       Tariff[]
  orders        Order[]
}

// Маршруты
model Route {
  id          String   @id @default(cuid())
  fromCountry String
  fromCity    String?
  toCountry   String
  toCity      String?
  transitTime Int // Дней в пути
  isActive    Boolean  @default(true)
  tariffs     Tariff[]
  orders      Order[]
}

// Тарифы (для калькулятора)
model Tariff {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  routeId    String
  route      Route    @relation(fields: [routeId], references: [id])
  pricePerKg Float
  minWeight  Float    @default(1)
  maxWeight  Float?
  minPrice   Float
  currency   String   @default("USD")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Заказы
model Order {
  id              String          @id @default(cuid())
  trackingNumber  String          @unique
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  serviceId       String
  service         Service         @relation(fields: [serviceId], references: [id])
  routeId         String?
  route           Route?          @relation(fields: [routeId], references: [id])
  // Данные клиента
  clientName      String
  clientEmail     String
  clientPhone     String
  clientCompany   String?
  // Информация о грузе
  cargoType       String // general, fragile, hazardous, perishable
  cargoDescription String         @db.Text
  weight          Float
  volume          Float?
  dimensions      String?
  quantity        Int             @default(1)
  declaredValue   Float?
  // Адреса
  pickupAddress   String          @db.Text
  deliveryAddress String          @db.Text
  // Статус и стоимость
  status          String          @default("new") // new, confirmed, in_transit, customs, delivered, cancelled
  estimatedCost   Float?
  finalCost       Float?
  estimatedDelivery DateTime?
  // Комментарии
  clientComment   String?         @db.Text
  adminComment    String?         @db.Text
  documents       Document[]
  trackingEvents  TrackingEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Документы
model Document {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  url       String
  type      String // invoice, packing_list, customs, other
  size      Int
  createdAt DateTime @default(now())
}

// События трекинга
model TrackingEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String // received, processing, shipped, in_transit, customs, out_for_delivery, delivered
  location    String?
  description String
  timestamp   DateTime @default(now())
}

// Заявки на обратный звонок
model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  service   String?
  message   String?  @db.Text
  status    String   @default("new") // new, contacted, completed
  createdAt DateTime @default(now())
}
